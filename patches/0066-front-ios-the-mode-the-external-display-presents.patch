index 0c965c7..e1e739e 100644
--- a/dm/ios/tests/duo/Tests/DuoHarnessTests.m
+++ b/dm/ios/tests/duo/Tests/DuoHarnessTests.m
@@ -735,7 +735,11 @@ static BOOL gDuoHarnessReduceMotionEnabled;
     [root.view layoutIfNeeded];
     UIView *game = [root valueForKey:@"game"];
     XCTAssertTrue(dm_setting_live("DM_PICTURE_FIT", NULL) && dm_setting_live("DM_OPMODE", NULL) && dm_setting_live("DM_RUMBLE", NULL)
-                  && dm_setting_live("DM_SHOW_FPS", NULL) && dm_setting_live("DM_TOUCH_HAPTICS", NULL) && dm_setting_live("DM_AUDIO_MIX", NULL));
+                  && dm_setting_live("DM_SHOW_FPS", NULL) && dm_setting_live("DM_TOUCH_HAPTICS", NULL) && dm_setting_live("DM_AUDIO_MIX", NULL)
+                  && dm_setting_live("DM_TV_DISPLAY", NULL), @"the shell's external-display setting probes as one the game takes at once");
+    XCTAssertTrue(dm_setting_live("DM_TV_DISPLAY", "720p"), @"a mode applies without a display connected (it names the next one)");
+    XCTAssertTrue(dm_setting_live("DM_TV_DISPLAY", "off"));
+    XCTAssertTrue(dm_setting_live("DM_TV_DISPLAY", "1080p"), @"back to the default for whatever runs next");
     XCTAssertFalse(dm_setting_live("DM_LANG", NULL), @"A setting the game reads once at start is not offered");
     XCTAssertFalse(dm_setting_live("DM_FPS_TARGET", NULL));
 
